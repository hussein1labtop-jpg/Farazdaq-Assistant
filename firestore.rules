rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الامتحانات: يُسمح بالإنشاء، والتعديل فقط ما دام الامتحان "قيد الإجراء" (لا يمكن إعادة امتحان منتهٍ)
    match /results/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.status == 'started';
      allow delete: if request.auth != null;
    }

    // الرسائل: لا تعديل على رسالة مرسلة
    match /{path=**}/messages/{id} {
      allow read, create, delete: if request.auth != null;
      allow update: if false;
    }

    // باقي البيانات: لأي جهاز مسجّل دخول مجهول (Anonymous) داخل التطبيق
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
